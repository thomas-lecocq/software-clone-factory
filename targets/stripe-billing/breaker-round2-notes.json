  {
    "id": "dev-brk2-flex-credit-after-none-change",
    "rules": ["PRO-01", "MOD-01", "PRO-08"],
    "input": {
      "kind": "lifecycle",
      "start": 1791158400,
      "amount": 1000,
      "trial_days": null,
      "coupon": null,
      "second_amount": 3000,
      "spare_coupon": null,
      "steps": [
        {
          "do": "advance",
          "seconds": 432000
        },
        {
          "do": "raw",
          "as": "swap",
          "method": "POST",
          "path": "/v1/subscriptions/{subscription}",
          "params": {
            "items[0][id]": "{item}",
            "items[0][price]": "{price2}",
            "proration_behavior": "none"
          }
        },
        {
          "do": "advance",
          "seconds": 432000
        },
        {
          "do": "raw",
          "as": "preview",
          "method": "POST",
          "path": "/v1/invoices/create_preview",
          "params": {
            "subscription": "{subscription}",
            "subscription_details[items][0][id]": "{item}",
            "subscription_details[items][0][quantity]": "2"
          }
        },
        {
          "do": "snapshot",
          "as": "after"
        }
      ]
    },
    "expect": "Flexible billing mode bases credit prorations on what was last billed: the 1000 first invoice, not the 3000 price set with proration_behavior=none. Credit about -677 (1000 x 21/31), charge 2 x 3000 x 21/31, renewal 6000.",
    "clone_today": "creditLine uses the item's current price (3000), so the credit is about -2032."
  },
